{
  "info": {
    "_postman_id": "c6358017-f452-4203-8021-5c263e9965fb",
    "name": "Taller Mecánico API",
    "description": "Colección para probar la API del taller. Ejecutá los requests en orden: los scripts guardan automáticamente clienteId, vehiculoId, ordenId y repuestoId en variables de la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Flujo principal",
      "item": [
        {
          "name": "1. Crear cliente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/clientes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan Pérez\",\n  \"telefono\": \"123456789\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Devuelve un id\", function () {",
                  "    pm.expect(body.id).to.be.a(\"string\");",
                  "});",
                  "pm.collectionVariables.set(\"clienteId\", body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Crear vehículo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/vehiculos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patente\": \"{{patente}}\",\n  \"marca\": \"Ford\",\n  \"modelo\": \"Fiesta\",\n  \"clienteId\": \"{{clienteId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const letras = \"ABCDEFGHIJKLMNOPQRSTUVWXYZ\";",
                  "const letra = () => letras[Math.floor(Math.random() * letras.length)];",
                  "const digito = () => Math.floor(Math.random() * 10);",
                  "const patente = letra() + letra() + letra() + digito() + digito() + digito();",
                  "pm.collectionVariables.set(\"patente\", patente);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"La patente se guardó correctamente\", function () {",
                  "    pm.expect(body.patente).to.eql(pm.collectionVariables.get(\"patente\"));",
                  "});",
                  "pm.collectionVariables.set(\"vehiculoId\", body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3. Crear orden",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/ordenes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehiculoId\": \"{{vehiculoId}}\",\n  \"descripcion\": \"Cambio de aceite\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"La orden nace INGRESADO\", function () {",
                  "    pm.expect(body.estado).to.eql(\"INGRESADO\");",
                  "});",
                  "pm.test(\"Tiene el historial inicial\", function () {",
                  "    pm.expect(body.historial).to.have.lengthOf(1);",
                  "});",
                  "pm.collectionVariables.set(\"ordenId\", body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3b. Segunda orden abierta (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/ordenes",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"vehiculoId\": \"{{vehiculoId}}\",\n  \"descripcion\": \"Otra orden\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"409 Conflict: el vehículo ya tiene una orden abierta\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "4. Crear repuesto",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/repuestos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Filtro de aceite\",\n  \"precio\": 1000,\n  \"stock\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Stock inicial 5\", function () {",
                  "    pm.expect(body.stock).to.eql(5);",
                  "});",
                  "pm.collectionVariables.set(\"repuestoId\", body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "5. Agregar repuesto a la orden",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/ordenes/{{ordenId}}/repuestos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"repuestoId\": \"{{repuestoId}}\",\n  \"cantidad\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"costoRepuestos = 2000\", function () {",
                  "    pm.expect(body.costoRepuestos).to.eql(2000);",
                  "});",
                  "pm.test(\"Se agregó una línea de repuesto\", function () {",
                  "    pm.expect(body.repuestos).to.have.lengthOf(1);",
                  "    pm.expect(body.repuestos[0].cantidad).to.eql(2);",
                  "    pm.expect(body.repuestos[0].subtotal).to.eql(2000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "5b. Costo final menor a repuestos (400)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/ordenes/{{ordenId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"costoFinal\": 1500\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"400 Bad Request: costoFinal menor a costoRepuestos\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "5c. Stock insuficiente (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/ordenes/{{ordenId}}/repuestos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"repuestoId\": \"{{repuestoId}}\",\n  \"cantidad\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"409 Conflict: stock insuficiente\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "6. Ver orden",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/ordenes/{{ordenId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Sigue INGRESADO\", function () {",
                  "    pm.expect(body.estado).to.eql(\"INGRESADO\");",
                  "});",
                  "pm.test(\"Mantiene el costo de repuestos\", function () {",
                  "    pm.expect(body.costoRepuestos).to.eql(2000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "7. Ver vehículos del cliente",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/clientes/{{clienteId}}/vehiculos"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"El cliente tiene un vehículo\", function () {",
                  "    pm.expect(body).to.have.lengthOf(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "8. Historial por patente",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/vehiculos/patente/{{patente}}/historial"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"El vehículo tiene una orden\", function () {",
                  "    pm.expect(body).to.have.lengthOf(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "9. Actualizar costo y pasar a EN_REPARACION",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/ordenes/{{ordenId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"costoFinal\": 2500,\n  \"estado\": \"EN_REPARACION\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Estado EN_REPARACION\", function () {",
                  "    pm.expect(body.estado).to.eql(\"EN_REPARACION\");",
                  "});",
                  "pm.test(\"Costo final cargado\", function () {",
                  "    pm.expect(body.costoFinal).to.eql(2500);",
                  "});",
                  "pm.test(\"Historial con 2 cambios\", function () {",
                  "    pm.expect(body.historial).to.have.lengthOf(2);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "10. Pasar a TERMINADO",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/ordenes/{{ordenId}}/estado",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"TERMINADO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Estado TERMINADO\", function () {",
                  "    pm.expect(body.estado).to.eql(\"TERMINADO\");",
                  "});",
                  "pm.test(\"Devuelve horasEnReparacion\", function () {",
                  "    pm.expect(body.horasEnReparacion).to.not.be.null;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "11. Entregar orden",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/ordenes/{{ordenId}}/estado",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"ENTREGADO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Estado ENTREGADO\", function () {",
                  "    pm.expect(body.estado).to.eql(\"ENTREGADO\");",
                  "});",
                  "pm.test(\"Historial con 4 cambios\", function () {",
                  "    pm.expect(body.historial).to.have.lengthOf(4);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "12. Facturación del mes",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/ordenes/facturacion?mes={{mes}}"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const ahora = new Date();",
                  "const mes = ahora.getFullYear() + \"-\" + String(ahora.getMonth() + 1).padStart(2, \"0\");",
                  "pm.collectionVariables.set(\"mes\", mes);"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.test(\"Hay al menos una orden entregada\", function () {",
                  "    pm.expect(body.cantidadOrdenes).to.be.at.least(1);",
                  "});",
                  "pm.test(\"El total incluye la orden entregada\", function () {",
                  "    pm.expect(body.totalFacturado).to.be.at.least(2500);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "13. Patente duplicada (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/vehiculos",
