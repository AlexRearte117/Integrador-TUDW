            ],
            "url": "{{baseUrl}}/api/ordenes/{{ordenPruebaId}}/estado",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"estado\": \"TERMINADO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
