          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/vehiculos",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patente\": \"{{patente2}}\",\n  \"marca\": \"Fiat\",\n  \"modelo\": \"Uno\",\n  \"clienteId\": \"{{clienteId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
